# Copy to backend/.env (gitignored). Never commit real values.
DATABASE_URL=sqlite+aiosqlite:///./registry.db

# Single admin account for the web console. Login is disabled (503) while ADMIN_PASSWORD is empty.
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=

# Optional: extra Host headers accepted by /mcp, comma-separated (localhost is always allowed).
# e.g. api:* for the compose network, or a public domain when exposing the backend directly.
MCP_ALLOWED_HOSTS=

# Optional: pin the JWT signing key so admin sessions survive restarts.
# Unset → entrypoint.sh generates a new one on every start.
JWT_SECRET=
